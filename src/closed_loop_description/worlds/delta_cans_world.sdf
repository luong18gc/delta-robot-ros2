    <!-- ===================== Camera nhìn xiên ===================== -->
    <!-- GIỮ NGUYÊN pose và nội tham số như world cũ để file hiệu chuẩn cũ còn dùng được và để so
         sánh sai số giữa hai thế giới. -->
    <model name="side_camera">
      <static>true</static>
      <pose>-0.40 0 1.03 0 0.558599 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
        </visual>
        <visual name="lens">
          <pose>0.025 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <sensor name="side_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>side_camera/image</topic>
          <gz_frame_id>side_camera</gz_frame_id>
          <camera>
            <horizontal_fov>0.785398</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>3.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Chân đế camera (chỉ hiển thị). -->
    <model name="side_camera_stand">
      <static>true</static>
      <pose>-0.40 0 0.9 0 0 0</pose>
      <link name="link">
        <visual name="post">
          <geometry><cylinder><radius>0.008</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

